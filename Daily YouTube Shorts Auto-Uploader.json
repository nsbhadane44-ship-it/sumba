    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nreturn items.map((i) => ({\n  json: {\n    timestamp: $now.toISO(),\n    workflow: $workflow.name,\n    executionId: $execution.id,\n    error: (i.json && (i.json.error || i.json.message)) || \"Unknown error\",\n    details: i.json || {},\n  },\n}));"
      },
      "id": "6e7f9e64-26c5-4944-8193-4d90c5b8bc0c",
      "name": "Log Error",
