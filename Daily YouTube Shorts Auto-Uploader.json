    {
      "parameters": {
        "resource": "video",
        "operation": "analyze",
        "modelId": {
          "__rl": true,
          "value": "models/gemini-3.5-flash",
          "mode": "list",
          "cachedResultName": "models/gemini-3.5-flash"
        },
        "text": "You are a YouTube Shorts growth expert. Watch this complete video and generate optimized metadata.\nRespond with ONLY a raw JSON object (no markdown, no code fences) using EXACTLY these keys:\n{\n  \"title\": \"viral YouTube title, MAX 100 characters\",\n  \"description\": \"SEO optimized YouTube description, 2-4 sentences\",\n  \"hashtags\": [\"array of exactly 20 relevant hashtags, each starting with #\"],\n  \"tags\": [\"array of exactly 20 keyword tags\"],\n  \"keywords\": \"short comma-separated SEO keywords\"\n}\nEnsure the title is under 100 characters. Return valid JSON only.",
        "inputType": "binary",
        "options": {
          "maxOutputTokens": 1024
        }
      },
      "id": "a8dfb58f-ec3b-4a01-a97d-bd3f20b4db4e",
      "name": "Gemini 2.5 Flash Vision",
      "type": "@n8n/n8n-nodes-langchain.googleGemini",
      "typeVersion": 1.2,
      "position": [
        896,
        272
      ],
      "retryOnFail": true,
      "credentials": {
        "googlePalmApi": {
          "id": "cy06CrG1myYLsqOE",
          "name": "Google Gemini(PaLM) Api account 2"
        }
      },
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $json.content ?? $json.text ?? $json.response ?? $json.output ?? \"\";\nlet textOut = typeof raw === \"string\" ? raw : JSON.stringify(raw);\ntextOut = textOut.replace(/```json/gi, \"\").replace(/```/g, \"\").trim();\nlet data = {};\ntry { data = JSON.parse(textOut); } catch (e) { data = {}; }\n\nconst title = String(data.title || \"New YouTube Short\").slice(0, 100);\nlet hashtags = data.hashtags;\nif (Array.isArray(hashtags)) hashtags = hashtags.join(\" \");\nhashtags = hashtags || \"\";\nlet tags = data.tags;\nif (Array.isArray(tags)) tags = tags.join(\", \");\ntags = String(tags || \"\");\nconst keywords = String(data.keywords || \"\");\nconst baseDesc = String(data.description || \"\");\nconst description = [baseDesc, \"\", hashtags, \"\", keywords ? (\"Keywords: \" + keywords) : \"\"].join(\"\\n\").trim();\n\nconst selected = $(\"Select Oldest Unprocessed\").item.json;\nconst dl = $(\"Download Video\").item;\nreturn {\n  json: {\n    title,\n    description,\n    tags,\n    hashtags,\n    keywords,\n    driveFileId: selected.id,\n    driveFileName: selected.name,\n  },\n  binary: dl && dl.binary ? dl.binary : {},\n};"
      },
      "id": "fdab361f-7e6e-44b8-965e-8ecb85ac5d43",
      "name": "Parse Metadata",
