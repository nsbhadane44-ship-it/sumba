      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst uploaded = Array.isArray(staticData.uploadedFileIds) ? staticData.uploadedFileIds : [];\nconst id = $(\"Select Oldest Unprocessed\").first().json.id;\nif (id && !uploaded.includes(id)) {\n  uploaded.push(id);\n}\nstaticData.uploadedFileIds = uploaded;\nreturn [{ json: { recordedFileId: id, totalUploaded: uploaded.length, uploadedAt: $now.toISO() } }];"
