    {
      "parameters": {
        "jsCode": "const staticData = $getWorkflowStaticData('global');\nconst uploaded = Array.isArray(staticData.uploadedFileIds) ? staticData.uploadedFileIds : [];\nconst files = $input.all().filter((i) => i.json && i.json.id);\n// Ignore videos that were already uploaded\nconst unprocessed = files.filter((i) => !uploaded.includes(i.json.id));\nif (unprocessed.length === 0) {\n  return [];\n}\n// Google Drive returns files in ascending creation order; the first is the oldest\nunprocessed.sort((a, b) => String(a.json.name || \"\").localeCompare(String(b.json.name || \"\")));\n// sanitize the file name (remove leading/trailing spaces and unsafe characters)\nconst chosen = unprocessed[0];\nconst rawName = String(chosen.json.name || \"video.mp4\");\nconst safeName = rawName.trim().replace(/\\s+/g, \"_\").replace(/[^A-Za-z0-9._-]/g, \"\") || \"video.mp4\";\nchosen.json.safeName = safeName;\nreturn [chosen];"
      },
      "id": "b8229891-0874-4b3d-ae40-0230c00c399b",
      "name": "Select Oldest Unprocessed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        336
      ]
    },
    {
      "parameters": {
        "operation": "download",
        "fileId": {
          "__rl": true,
          "mode": "id",
          "value": "={{ $json.id }}"
        },
        "options": {
          "binaryPropertyName": "data",
          "fileName": "={{ $json.safeName }}"
        }
      },
      "id": "5e17442e-76f5-498f-a8d8-55e3c8a0b005",
      "name": "Download Video",
      "type": "n8n-nodes-base.googleDrive",
